.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
# Control API token (runtime secret, generated per install)
control-token
**/control-token

# Editor agent scratch
.qoder/

# Dependencies
node_modules/
.pnpm-store/
.npm-cache/
.electron-cache/
.chrome-debug-*/

# Build output
dist/
build/
release/chrome-extension/
release/*.zip
release/SHA256SUMS.txt
release/desktop/
*.pfx
*.p12
*.tsbuildinfo

# Test artifacts
test-results/
playwright-report/
coverage/
tests/.artifacts/
.artifacts/

# Temporary / scratch files
temp/
backups/

# Python virtual environments & cache
venv/
.venv/
__pycache__/
*.pyc

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
logs/
