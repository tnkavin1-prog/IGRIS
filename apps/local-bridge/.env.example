# Copy to .env and fill in real values, or run scripts/setup-windows.ps1.
# This file is committed as documentation; .env itself is gitignored.

# Permanent Gemini API key. It is read only by the local bridge process.
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE

# Shared secret pasted once into the extension. 32+ random characters.
LOCAL_GATE_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS

# Loopback port. Must match the bridge URL in extension Settings.
PORT=47821

# Stable Chrome extension id(s), comma separated. Derive it with
# scripts/setup-windows.ps1; it must match the manifest "key".
ALLOWED_EXTENSION_IDS=replace-with-32-character-extension-id

# Optional tuning.
TOKEN_TTL_MINUTES=30
NEW_SESSION_TTL_SECONDS=60
RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=info
ALLOWED_ORIGINS=
