{
  "manifest_version": 3,
  "name": "Gemini Browser Live",
  "version": "1.0.0",
  "description": "A real-time Gemini voice agent that can inspect, read, and operate your Chrome tabs — with approval gates for consequential actions.",
  "minimum_chrome_version": "116",
  "key": "",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://generativelanguage.googleapis.com wss://generativelanguage.googleapis.com http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*;"
  },
  "permissions": ["sidePanel", "tabs", "scripting", "storage", "activeTab", "contextMenus"],
  "optional_permissions": ["downloads", "bookmarks", "history"],
  "host_permissions": [
    "http://127.0.0.1:*/*",
    "https://generativelanguage.googleapis.com/*",
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ask Gemini",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["overlay.html", "blackboard.html", "assets/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_page": "sidepanel.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+G" },
      "description": "Ask Gemini"
    },
    "start-session": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Start a live Gemini session"
    },
    "stop-session": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "End the live session"
    },
    "toggle-mic": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Mute or unmute the microphone"
    },
    "open-settings": {
      "description": "Open Gemini Browser Live settings"
    }
  }
}
